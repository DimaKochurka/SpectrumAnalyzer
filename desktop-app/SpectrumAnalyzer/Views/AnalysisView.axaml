<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:vm="using:SpectrumAnalyzer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SpectrumAnalyzer.Views.AnalysisView"
             x:DataType="vm:AnalysisViewModel">

    <Grid RowDefinitions="*, Auto" Margin="20">
        
        <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
            <sp:AvaPlot Name="SpectrumPlot"/>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto, Auto" ShowGridLines="False">
            
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,15">
                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="Dominant Frequency" Foreground="#A0A0A0" FontSize="12"/>
                    <TextBlock Text="{Binding DominantFrequency}" FontSize="18" FontWeight="Bold" Foreground="#4facfe"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Amplitude" Foreground="#A0A0A0" FontSize="12"/>
                    <TextBlock Text="{Binding PeakAmplitude}" FontSize="18" FontWeight="Bold" Foreground="#00f2fe"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Structure" Foreground="#A0A0A0" FontSize="12"/>
                    <TextBlock Text="{Binding HarmonicStructure}" FontSize="18" FontWeight="Bold" Foreground="Orange" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,15">
        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Text="Timbre" Foreground="#A0A0A0" FontSize="12"/>
            <TextBlock Text="{Binding TimbreCheck}" FontSize="18" FontWeight="Bold" Foreground="#81C784" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Source Direction" Foreground="#A0A0A0" FontSize="12"/>
            <TextBlock Text="{Binding SourceDirection}" FontSize="18" FontWeight="Bold" Foreground="#FFCA28" TextWrapping="Wrap"/>
        </StackPanel>
            </Grid>
            
            <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="SOUND SOURCE ANALYSIS:" Foreground="#A0A0A0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding PredictedSource}" FontSize="22" FontWeight="Black" Foreground="#4CAF50" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SecondaryPredictedSource}" Foreground="#4CAF50" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*, *" Margin="0,20,0,0">
                <Button Grid.Column="0" Content="Back to Home"
                        Command="{Binding ReturnToHomeCommand}"
                        Background="Transparent" BorderBrush="#555555" BorderThickness="1" Foreground="#A0A0A0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,0,10,0" Padding="10,12" CornerRadius="8" FontSize="14" FontWeight="SemiBold"/>

                <Button Grid.Column="1" Content="{Binding PlayPauseButtonText}"
                        Command="{Binding TogglePlayPauseCommand}"
                        Background="#2A2A2A" Foreground="Orange"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="10,0,0,0" Padding="10,12" CornerRadius="8" FontSize="14" FontWeight="Bold"/>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>